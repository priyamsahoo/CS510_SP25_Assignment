import re

def solve():
    s = raw_input().strip()
    pattern = r"^[a-zA-Z0-9_]{1,16}@[a-zA-Z0-9_]+(\.[a-zA-Z0-9_]+){0,31}(/[a-zA-Z0-9_]{1,16})?$"
