    if match:
        parts = s.split('@')
        if len(parts) != 2:
            print "NO"
            return
        username = parts[0]
        rest = parts[1]

        if not (1 <= len(username) <= 16 and re.match(r"^[a-zA-Z0-9_]+$", username)):
            print "NO"
            return
        
        resource_split = rest.split('/')
        hostname = resource_split[0]
        resource = None
        if len(resource_split) > 1:
            resource = resource_split[1]

        if not (1 <= len(hostname) <= 32):
            print "NO"
            return

        hostname_parts = hostname.split('.')
        for part in hostname_parts:
            if not (1 <= len(part) <= 16 and re.match(r"^[a-zA-Z0-9_]+$", part)):
                print "NO"
                return
        
        if resource is not None:
            if not (1 <= len(resource) <= 16 and re.match(r"^[a-zA-Z0-9_]+$", resource)):
                print "NO"
                return

        print "YES"
    else:
        print "NO"

solve()
