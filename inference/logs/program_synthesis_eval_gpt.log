  "target_code": "from collections import deque\n\ndef find_time_periods(n, k, heights):\n    max_books = 0\n    periods = []\n    min_heights = deque()\n    max_heights = deque()\n    start = 0\n    end = 0\n    \n    while end < n:\n        while min_heights and heights[end] < heights[min_heights[-1]]:\n            min_heights.pop()\n        min_heights.append(end)\n        \n        while max_heights and heights[end] > heights[max_heights[-1]]:\n            max_heights.pop()\n        max_heights.append(end)\n        \n        if heights[max_heights[0]] - heights[min_heights[0]] > k:\n            start += 1\n            if start > end:\n                end += 1\n                continue\n            \n            if start > min_heights[0]:\n                min_heights.popleft()\n            if start > max_heights[0]:\n                max_heights.popleft()\n        else:\n            num_books = end - start + 1\n            if num_books > max_books:\n                max_books = num_books\n                periods = [(start+1, end+1)]\n            elif num_books == max_books:\n                periods.append((start+1, end+1))\n            end += 1\n    \n    return max_books, periods\n\n# Input\ninputs = [\n    (3, 3, [14, 12, 10]),\n    (2, 0, [10, 10]),\n    (4, 5, [8, 19, 10, 13])\n]\n\n# Output\noutputs = [find_time_periods(n, k, heights) for n, k, heights in inputs]\n\nprint(outputs)"
