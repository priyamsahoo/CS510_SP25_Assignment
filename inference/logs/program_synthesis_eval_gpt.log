{
  "version": "Python 3",
  "target_code": "
from collections import deque

def find_path(n, m, k, grid):
    directions = [(0, 1), (0, -1), (1, 0), (-1, 0)]
    start = None
    end = None
    
    for i in range(n):
        for j in range(m):
            if grid[i][j] == 'S':
                start = (i, j)
            elif grid[i][j] == 'T':
                end = (i, j)
    
    visited = set()
    queue = deque([(start, "", 0)])
    
    while queue:
        (x, y), path, types = queue.popleft()
        
        if (x, y) == end:
            return path
        
        visited.add((x, y))
        
        for dx, dy in directions:
            nx, ny = x + dx, y + dy
            if 0 <= nx < n and 0 <= ny < m and (nx, ny) not in visited:
                new_types = types + (grid[nx][ny] not in ['S', 'T'])
                
                if new_types <= k:
                    queue.append(((nx, ny), path + grid[nx][ny], new_types))
    
    return '-1'

# Input parsing
inputs = ['5 3 2\nSba\nccc\naac\nccc\nabT', '3 4 1\nSxyy\nyxxx\nyyyT', '1 3 3\nTyS', '1 4 1\nSxyT']
for input_str in inputs:
    n, m, k = map(int, input_str.split()[0].split())
    grid = [list(row) for row in input_str.split()[1:]]
    
    result = find_path(n, m, k, grid)
    print(result)
"
}
