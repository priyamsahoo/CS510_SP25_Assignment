 input\\nN, max_health, regen_rate = map(int, input().split())\\nscrolls = []\\nfor _ in range(N):\\n    powi, dmgi = map(int, input().split())\\n    scrolls.append((powi, dmgi))\\n\\n# Initialize variables\\nboss_health = max_health\\nseconds = 0\\nused_scrolls = []\\n\\n# Main logic\\nwhile boss_health > 0:\\n    boss_health -= sum(dmgi for powi, dmgi in scrolls if boss_health * 100 > powi)\\n    boss_health = min(boss_health + regen_rate, max_health)\\n    if boss_health <= 0:\\n        break\\n    for i, (powi, dmgi) in enumerate(scrolls):\\n        if boss_health * 100 > powi:\\n            boss_health -= dmgi\\n            used_scrolls.append((seconds, i+1))\\n            break\\n    seconds += 1\\n\\n# Output result\\nif boss_health <= 0:\\n    print(\'YES\')\\n    print(seconds, len(used_scrolls))\\n    for used_scroll in used_scrolls:\\n        print(used_scroll[0], used_scroll[1])\\nelse:\\n    print(\'NO\')"\n}\n]', '[\n{\n  "version": "Python 3",\n  "target_code": "import sys\\n\\n# Read input\\nN, max_health, regen_rate = map(int, input().split())\\nscrolls = []\\nfor _ in range(N):\\n    powi, dmgi = map(int, input().split())\\n    scrolls.append((powi, dmgi))\\n\\n# Initialize variables\\nboss_health = max_health\\nseconds = 0\\nused_scrolls = []\\n\\n# Simulate the battle\\nwhile boss_health > 0:\\n    boss_health -= sum(d * dmgi for d, dmgi in used_scrolls)\\n    boss_health = min(boss_health + regen_rate, max_health)\\n    for i, (powi, dmgi) in enumerate(scrolls):\\n        if boss_health > powi:\\n            used_scrolls.append((1, dmgi))\\n            scrolls.pop(i)\\n            break\\n    seconds += 1\\n\\n# Output results\\nif boss_health <= 0:\\n    print(\'YES\')\\n    print(seconds, len(used_scrolls))\\n    for s, d in used_scrolls:\\n        print(s-1, d)\\nelse:\\n    print(\'NO\')"\n}\n]', '[\n{\n  "version": "Python 3",\n  "target_code": "import sys\\n\\ndef can_defeat_boss(N, max_health, regen_rate, scrolls):\\n    total_damage = 0\