{
  "version": "Python 3",
  "target_code": "
n = int(input())
heights = list(map(int, input().split()))

def count_pairs(n, heights):
    pairs = 0
    max_left = [0] * n
    max_right = [0] * n

    for i in range(1, n):
        max_left[i] = max(max_left[i-1], heights[i-1])

    for i in range(n-2, -1, -1):
        max_right[i] = max(max_right[i+1], heights[i+1])

    for i in range(n):
        if heights[i] > max_left[i] and heights[i] > max_right[i]:
            pairs += 1

    return pairs

print(count_pairs(n, heights))
"
}
]
