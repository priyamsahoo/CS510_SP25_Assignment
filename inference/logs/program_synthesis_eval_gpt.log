2025-05-01 21:05:23 - run_gpt.py - INFO - response: ['### Solution\n\n[{\n  "version": "Python 3",\n  "target_code": "from typing import List\\n\\ndef find_time_periods(n: int, k: int, heights: List[int]) -> List[List[int]]:\\n    max_books = 0\\n    periods = []\\n    start = 0\\n    end = 0\\n    min_height = float(\'inf\')\\n    max_height = float(\'-inf\')\\n    \\n    while end < n:\\n        if max_height - min_height <= k:\\n            if end - start + 1 > max_books:\\n                max_books = end - start + 1\\n                periods = [[start + 1, end + 1]]\\n            elif end - start + 1 == max_books:\\n                periods.append([start + 1, end + 1])\\n            end += 1\\n            if end < n:\\n                min_height = min(min_height, heights[end])\\n                max_height = max(max_height, heights[end])\\n        else:\\n            start += 1\\n            if start > end:\\n                end = start\\n                if end < n:\\n                    min_height = heights[end]\\n                    max_height = heights[end]\\n    \\n    return [[max_books, len(periods)]] + periods\\n\\n\\n# Input parsing\\ninput_data = input().strip().split(\'\\\\n\')\\nn, k = map(int, input_data[0].split())\\nheights = list(map(int, input_data[1].split()))\\n\\n# Call the function and output the result\\nresult = find_time_periods(n, k, heights)\\nfor p in result:\\n    print(\' \'.join(map(str, p)))"\n}]', '### Solution\n\n[{\n  "version": "Python 3",\n  "target_code": "from collections import deque\\n\\ndef find_time_periods(n, k, heights):\\n    max_books = 0\\n    periods = []\\n    min_heights = deque()\\n    max_heights = deque()\\n    start = 0\\n    end = 0\\n    \\n    while end < n:\\n        while min_heights and heights[end] < heights[min_heights[-1]]:\\n            min_heights.pop()\\n        min_heights.append(end)\\n        \\n        while max_heights and heights[end] > heights[max_heights[-1]]:\\n            max_heights.pop()\\n        max_heights.append(end)\\n        \\n        if heights[max_heights[0]] - heights[min_heights[0]] > k:\\n            start += 1\\n            if start > end:\\n                end += 1\\n                continue\\n            \\n            if start > min_heights[0]:\\n                min_heights.popleft()\\n            if start > max_heights[0]:\\n                max_heights.popleft()\\n        else:\\n            num_books = end - start + 1\\n            if num_books > max_books:\\n                max_books = num_books\\n                periods = [(start+1, end+1)]\\n            elif num_books == max_books:\\n                periods.append((start+1, end+1))\\n            end += 1\\n    \\n    return max_books, periods\\n\\n# Input\\ninputs = [\\n    (3, 3, [14, 12, 10]),\\n    (2, 0, [10, 10]),\\n    (4, 5, [8, 19, 10, 13])\\n]\\n\\n# Output\\noutputs = [find_time_periods(n, k, heights) for n, k, heights in inputs]\\n\\nprint(outputs)"\n}]', '[\n{\n  "version": "Python 3",\n  "target_code": "from collections import deque\\n\\n\\ndef find_time_periods(n, k, heights):\\n    max_books = 0\\n    periods = []\\n    min_height = float(\'inf\')\\n    max_height = float(\'-inf\')\\n    start_index = 0\\n    end_index = 0\\n    window = deque()\\n\\n    for i in range(n):\\n        height = heights[i]\\n        window.append(height)\\n        min_height = min(min_height, height)\\n        max_height = max(max_height, height)\\n\\n        while max_height - min_height > k:\\n            left = window.popleft()\\n            min_height = min(window) if window else float(\'inf\')\\n            max_height = max(window) if window else float(\'-inf\')\\n            start_index += 1\\n\\n        if i - start_index + 1 > max_books:\\n            max_books = i - start_index + 1\\n            periods = [(start_index + 1, i + 1)]\\n        elif i - start_index + 1 == max_books:\\n            periods.append((start_index + 1, i + 1))\\n\\n    return max_books, periods\\n\\n\\nif __name__ == \'__main__\':\\n    inputs = input().strip().split(\'\\\\n\')\\n    n, k = map(int, inputs[0].split())\\n    heights = list(map(int, inputs[1].split()))\\n\\n    max_books, periods = find_time_periods(n, k, heights)\\n    print(max_books, len(periods))\\n    for period in periods:\\n        print(period[0], period[1])"\n}\n]', '### Solution\n\n[{\n  "version": "Python 3",\n  "target_code": "from collections import deque\\n\\n\\ndef find_time_periods(n, k, heights):\\n    max_books = 0\\n    periods = []\\n    min_height = float(\'inf\')\\n    max_height = float(\'-inf\')\\n    start_idx = 0\\n    end_idx = 0\\n    deque_heights = deque()\\n\\n    for i in range(n):\\n        deque_heights.append(heights[i])\\n        min_height = min(min_height, heights[i])\\n        max_height = max(max_height, heights[i])\\n\\n        while max_height - min_height > k:\\n            deque_heights.popleft()\\n            if deque_heights:\\n                min_height = min(deque_heights)\\n                max_height = max(deque_heights)\\n            else:\\n                min_height = float(\'inf\')\\n                max_height = float(\'-inf\')\\n\\n        if len(deque_heights) > max_books:\\n            max_books = len(deque_heights)\\n            periods = [(start_idx + 1, i + 1)]\\n        elif len(deque_heights) == max_books:\\n            periods.append((start_idx + 1, i + 1))\\n\\n    return max_books, periods\\n\\n\\nif __name__ == \'__main__\':\\n    input_data = input().strip().split(\'\\\\n\')\\n    n, k = map(int, input_data[0].split())\\n    heights = list(map(int, input_data[1].split()))\\n\\n    max_books, periods = find_time_periods(n, k, heights)\\n\\n    print(max_books, len(periods))\\n    for period in periods:\\n        print(period[0], period[1])"\n}]', '[\n{\n  "version": "Python 3",\n  "target_code": "from typing import List\\n\\ndef find_exposition_books(n: int, k: int, heights: List[int]) -> List[List[int]]:\n    max_books = 0\n    periods = []\n    \n    start = 0\n    end = 0\n    min_height = heights[0]\n    max_height = heights[0]\n    \n    for i in range(1, n):\n        if abs(heights[i] - min_height) <= k and abs(heights[i] - max_height) <= k:\n            end = i\n            max_books = max(max_books, end - start + 1)\n        else:\n            periods.append([start + 1, end + 1])\n            start = i\n            end = i\n            min_height = heights[i]\n            max_height = heights[i]\n    \n    periods.append([start + 1, end + 1])\n    \n    return [max_books, periods]\\n\\n\\n# Input parsing\ninput_data = input().strip().split(\'\\\\n\')\nn, k = map(int, input_data[0].split())\nheights = list(map(int, input_data[1].split()))\n\n# Call the function and get the result\nresult = find_exposition_books(n, k, heights)\n\n# Print the result\nprint(result[0])\nfor period in result[1]:\n    print(period[0], period[1])"\n}\n}]']
